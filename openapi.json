{
  "openapi": "3.1.0",
  "info": {
    "title": "layerwatch-ai",
    "version": "0.3.0",
    "description": "The routes LayerWatch AI serves. Every path is relative to the mount the host assigns."
  },
  "paths": {
    "/status": {
      "get": {
        "operationId": "read-status",
        "summary": "Every camera LayerWatch AI follows",
        "description": "The detector and action in use, and for every camera that sent a snapshot: its printer, whether it prints, the latest score and the verdict. The host takes view_resource on the module's instance before this is called.",
        "responses": {
          "200": {
            "description": "The cameras followed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/incidents": {
      "get": {
        "operationId": "list-incidents",
        "summary": "The prints judged failed, newest first",
        "description": "Every incident LayerWatch AI stored, at most 50 per printer, newest first. The host takes view_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "printer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only this printer's incidents."
          }
        ],
        "responses": {
          "200": {
            "description": "The incidents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "incidents": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Incident"
                      }
                    }
                  },
                  "required": [
                    "incidents"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The record store did not answer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/printers/{printer}/reset": {
      "post": {
        "operationId": "reset-printer",
        "summary": "Mark the current picture as normal",
        "description": "For a false alarm: every camera of the printer starts a new baseline, and LayerWatch AI may act again on this print. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {
            "name": "printer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The baseline starts over."
          },
          "404": {
            "description": "No camera of this printer has sent a snapshot.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/check": {
      "get": {
        "operationId": "check-detector",
        "summary": "Check the detector",
        "description": "Asks the Obico ML API's health endpoint whether it answers and accepts the token. The built-in check always answers.",
        "responses": {
          "200": {
            "description": "The result of the check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Check"
                }
              }
            }
          }
        }
      }
    },
    "/printers/{printer}/test": {
      "post": {
        "operationId": "test-printer",
        "summary": "Analyse the newest frame as a test",
        "description": "Scores the newest snapshot of the printer's camera. The result is not followed and never pauses the print.",
        "parameters": [
          {
            "name": "printer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "What the detector found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Test"
                }
              }
            }
          },
          "404": {
            "description": "No camera of this printer has sent a snapshot.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "502": {
            "description": "The detector could not analyse the picture.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Box": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "confidence",
          "x",
          "y",
          "w",
          "h"
        ]
      },
      "Watch": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "string"
          },
          "printer": {
            "type": "string"
          },
          "printing": {
            "type": "boolean"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "warming_up",
              "ok",
              "warning",
              "failing"
            ]
          },
          "score": {
            "type": "number",
            "description": "The latest frame's score."
          },
          "excess": {
            "type": "number",
            "description": "The smoothed score above the print's baseline, which the thresholds judge."
          },
          "frames": {
            "type": "integer"
          },
          "last": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          },
          "acted": {
            "type": "boolean",
            "description": "LayerWatch AI already acted on this print."
          },
          "boxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Box"
            },
            "description": "Regions flagged on the last frame, in that frame's pixels."
          }
        },
        "required": [
          "camera",
          "printer",
          "printing",
          "verdict",
          "score",
          "excess",
          "frames",
          "last",
          "acted"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "detector": {
            "type": "string",
            "enum": [
              "heuristic",
              "obico"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "notify"
            ]
          },
          "cameras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Watch"
            }
          },
          "health": {
            "$ref": "#/components/schemas/Health"
          }
        },
        "required": [
          "detector",
          "action",
          "cameras",
          "health"
        ]
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "printer": {
            "type": "string"
          },
          "camera": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "score": {
            "type": "number"
          },
          "excess": {
            "type": "number"
          },
          "detector": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "boxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Box"
            }
          }
        },
        "required": [
          "id",
          "printer",
          "camera",
          "time",
          "score",
          "excess",
          "detector",
          "action",
          "outcome",
          "storage",
          "path"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "detector": {
            "type": "string"
          },
          "analyses": {
            "type": "integer"
          },
          "failures": {
            "type": "integer"
          },
          "last_ok": {
            "type": "string",
            "format": "date-time"
          },
          "last_millis": {
            "type": "integer"
          },
          "last_error": {
            "type": "string"
          },
          "error_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "detector",
          "analyses",
          "failures",
          "last_ok",
          "last_millis",
          "error_at"
        ]
      },
      "Check": {
        "type": "object",
        "properties": {
          "detector": {
            "type": "string"
          },
          "reachable": {
            "type": "boolean"
          },
          "millis": {
            "type": "integer"
          },
          "problem": {
            "type": "string"
          }
        },
        "required": [
          "detector",
          "reachable",
          "millis"
        ]
      },
      "Test": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "string"
          },
          "detector": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "boxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Box"
            }
          },
          "millis": {
            "type": "integer"
          },
          "taken": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "camera",
          "detector",
          "score",
          "boxes",
          "millis",
          "taken"
        ]
      }
    }
  }
}
